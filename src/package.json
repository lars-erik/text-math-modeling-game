{
  "name": "text-math-modeling-game",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "browser:install": "node tools/browser.mjs install",
    "build": "tsc --project tsconfig.build.json && vite build",
    "dev": "vite",
    "test": "npm run test:node && npm run test:browser",
    "test:approval": "vitest run --config vitest.config.ts testing/approval-tooling.test.ts",
    "test:browser": "node tools/browser.mjs test --reporter=default --reporter=junit --outputFile.junit=./test-results/browser/junit.xml --reporter=html --outputFile.html=./test-results/browser/index.html",
    "test:node": "vitest run --config vitest.config.ts --reporter=default --reporter=junit --outputFile.junit=./test-results/node/junit.xml --reporter=html --outputFile.html=./test-results/node/index.html",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "@vitest/browser-playwright": "5.0.1",
    "approvals": "7.3.0",
    "fast-check": "4.10.1",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "katex": "0.18.7",
    "lit": "3.3.3",
    "ohm-js": "17.5.0"
  }
}
